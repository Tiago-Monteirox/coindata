# Arquivos do Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Ambiente virtual
env/
venv/
.venv/

# Banco de dados SQLite (não versionar bancos de dados locais)
db.sqlite3
*.sqlite3

# Arquivos de ambiente
.env
.env.local
.env.*.local

# Arquivos do Django
*.log
staticfiles/
media/

# Diretório de logs (você pode querer versionar logs vazios)
logs/*.log
!logs/.gitkeep  # Mantém o diretório vazio versionado

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# Arquivos gerados pelo sistema
.DS_Store
Thumbs.db

# Arquivos de migração (exceto o __init__.py)
*/migrations/*.py
!*/migrations/__init__.py

# Arquivos de script temporários
*.bak
*.tmp

# Arquivos de configuração local
local_settings.py
settings/local.py

# Arquivos de cobertura
.coverage
htmlcov/

# Arquivos de pacote/distribuição
*.egg-info/
*.egg
dist/
build/
